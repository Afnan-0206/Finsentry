# ==========================================
# FinSentry AI - Core Configuration Template
# ==========================================

PROJECT_NAME="FinSentry AI"
TAGLINE="Your money. Your patterns. Your protection."
API_V1_PREFIX="/api"

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="sqlite:///./data/finsentry.db"
# Production (Managed PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/finsentry"

# Base Financial Settings
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"

# Machine Learning Anomaly Detection (Isolation Forest)
ISOLATION_FOREST_CONTAMINATION=0.05
MIN_TRANSACTIONS_FOR_ML=20

# ==========================================
# AI Provider Architecture
# Options: "ollama" | "cloudflare" | "deterministic"
# ==========================================
AI_PROVIDER="ollama"

# 1. Local Ollama Inference (Development)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT=60.0

# 2. Cloudflare Workers AI (Production)
# CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
# CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
# CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"

# Frontend Configuration
# VITE_API_BASE_URL="https://api.yourdomain.com/api"
