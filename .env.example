# ==============================================================================
# FinSentry AI — Configuration (Local SQLite + Cloudflare Quick Tunnel)
# Architecture: Public HTTPS -> Cloudflare Tunnel -> Vite Preview (4173) -> FastAPI (8001) -> Local SQLite
# ==============================================================================

PROJECT_NAME="FinSentry AI"
TAGLINE="Your money. Your patterns. Your protection."
API_V1_PREFIX="/api"

# Single Source of Truth: Permanent Local SQLite Database on this machine
# Automatically anchored to backend/data/finsentry.db
DATABASE_URL="sqlite:///./data/finsentry.db"

# Allowed CORS Origins (supports local dev and free Cloudflare Tunnels)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]'

# Regional & Financial Parameters
DEFAULT_CURRENCY="INR"
CURRENCY_SYMBOL="₹"

# Machine Learning Anomaly Detection (Isolation Forest)
ISOLATION_FOREST_CONTAMINATION=0.05
MIN_TRANSACTIONS_FOR_ML=20

# AI Provider Settings (ollama | cloudflare | deterministic)
AI_PROVIDER="ollama"

# Local Ollama Inference
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT=60.0
OLLAMA_KEEP_ALIVE="15m"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=350

# Optional: Cloudflare Workers AI Fallback
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"

# Frontend Configuration:
# In development & Vite preview: uses relative /api (proxied via Vite to http://127.0.0.1:8001)
# No external database or paid hosting required.
